MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 6.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
// macOS Studio/Admin sign with <App>$(AUN_MAC_ENTITLEMENTS_VARIANT).entitlements. Empty: with Associated Domains,
// which needs a provisioning profile. ".adhoc": without it, for ad hoc and unsigned builds (CI tests), because
// macOS refuses to launch an app that claims a restricted entitlement without a profile.
AUN_MAC_ENTITLEMENTS_VARIANT =
