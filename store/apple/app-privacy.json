          ]
        },
        {
          "what": "Watch history, views, usage data",
          "answer": "not sent: catalog and subtitle reads are GETs without an account; playback is AVPlayer streaming",
          "sources": [
            "Packages/AUNCoreBridge/Sources/AUNCoreBridge/NativeCatalogService.swift",
            "Packages/AUNPlayer/Sources/AUNPlayer/PlayerController.swift"
          ]
        },
        {
          "what": "Site theme",
          "answer": "read from the public admin-api endpoint, nothing sent",
          "sources": [
            "Packages/AUNCoreBridge/Sources/AUNCoreBridge/SiteTheme.swift"
          ]
        },
        {
          "what": "Device identifiers",
          "answer": "none: no App Attest in the viewer (it makes no writes)",
          "sources": [
            "Packages/AUNFeatures/Sources/AUNFeatures/ViewerBootstrap.swift"
          ]
        },
        {
          "what": "Analytics, advertising or tracking SDKs",
          "answer": "none: the apps link no third-party SDK; Apple frameworks and aun-core only",
          "sources": [
            "project.yml",
            "Packages/AUNCoreKit/Package.swift"
          ]
        },
        {
          "what": "Crash and diagnostic logs",
          "answer": "not sent: AUNLog writes to the device's unified log (os.Logger) only",
          "sources": [
            "Packages/AUNCoreBridge/Sources/AUNCoreBridge/AppEnvironment.swift"
          ]
        },
        {
          "what": "Settings (language, theme)",
          "answer": "kept on the device (UserDefaults)",
          "sources": [
            "Packages/AUNDesign/Sources/AUNDesign/AppSettings.swift"
          ]
        },
        {
          "what": "Where the last video stopped",
          "answer": "kept on the device, one entry (UserDefaults)",
          "sources": [
            "Packages/AUNPlayer/Sources/AUNPlayer/PlaybackPositionStore.swift"
          ]
        },
        {
          "what": "Location, contacts, health, financial info, browsing history, purchases",
